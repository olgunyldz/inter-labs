UI;" vertex="1" parent="1"><mxGeometry x="1420.0" y="140.0" width="760.0" height="116.0" as="geometry"/></mxCell><mxCell id="v94" value="LAB PERİMETRESİ · Docker Desktop (Windows 11) · tek host" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#f2f2f2;fillOpacity=0;strokeColor=#a3a3a3;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#a3a3a3;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="14.0" y="290.0" width="2172.0" height="1147.5" as="geometry"/></mxCell><mxCell id="v102" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Okuma sırası · siyah etiket = ayrıntı resmi&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;00 · genel bakış (bu resim): her zone'da lab'da çalışan ve olması gereken servisler&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;01 · edge zone: edge-lb (HAProxy) içi, kanallar, Docker ağları&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;02 · DMZ cluster'ları: namespace'ler, pod'lar, ingress kuralları · 03 · DMZ ingress pod'u içi&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;04 · uygulama cluster'ları · 05 · demo-app pod'u içi&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;06 · data cluster'ı: PostgreSQL, Redis, TCP girişi · 07 · mgmt cluster'ı ve ağ bacakları&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;08 · bir kind node'unun anatomisi · 09 · uçtan uca istek, adım adım&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="1467.5" width="1060.0" height="145.0" as="g