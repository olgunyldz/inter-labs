eometry x="14.0" y="148.0" width="2172.0" height="682.0" as="geometry"/></mxCell><mxCell id="v108" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Tüm yeni servisler .NET 8 (ASP.NET Core), aynı image üç cluster'a gider.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Veri: işlem verisi MSSQL'de, servis başına ayrı DB; olaylar outbox ile Kafka'ya.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Monolith ile konuşma yalnızca integration namespace'inden (ACL); doğrudan Oracle yok.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Servis adları ve dağılım önerilir; mevcut domain'lerinize göre uyarlanır. Pod içi: 04.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="860.0" width="1060.0" height="108.0" as="geometry"/></mxCell><mxCell id="v109" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="860.0" width="1060.0" height="240.0" as="geometry"/></mxCell><mxCell id="v143" value="03 · Uygulama cluster'ı: .NET mikroservisler, entegrasyon, platform, veri bağımlılıkları" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1326.0" height="33.8" as="geometry"/></mxCell><mxCell id="v144" value="her kutu bir namespace · cluster-a, cluster-b ve cluster-dr aynı · teyitli: Kubernetes, in