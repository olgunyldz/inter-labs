><mxGeometry x="20.0" y="239.5" width="426.0" height="16.9" as="geometry"/></mxCell><mxCell id="v23" value="Secret postgres: parola 'demo-pass' düz metin (yalnızca demo)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#b91c1c;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v14"><mxGeometry x="20.0" y="261.5" width="463.5" height="16.9" as="geometry"/></mxCell><mxCell id="v11" value="Deployment ×1" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="563.8" y="7.5" width="88.2" height="15.5" as="geometry"/></mxCell><mxCell id="v12" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;controller · registry.k8s.io/ingress-nginx/controller:v1.15.1&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;hostPort :5432 · :6379 (+ :80 / :443 kullanılmıyor)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;ConfigMap tcp-services (values-data.yaml):&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;  5432 → data/postgres:5432&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;  6379 → data/redis:6379&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;nginx stream modülü: düz TCP proxy · TLS yok&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;kaynak IP filtresi yok: segmentasyon ağ seviyesinde&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="8.0" y="28.0" width="644.0" height="124.0" as="geometry"/></mxCell><mxCell id="v16" value="StatefulSet ×1 · serviceName postgres" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="412.0" y="7.5" width="240.0" height="15.5" as="geometry"/></mxCell><mxCell id="v17" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;postgres · postgres:16-alpine&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;:5432 · readiness pg_isready -U app (5 sn)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;envFrom Secret postgres: POSTGRES_USER=app · DB=app&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;PGDATA /var/lib/postgresql/data/pgdata&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;requests cpu 50m · mem 128Mi · limits mem 512Mi&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3ecfb;strokeColor=#a383e0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="28.0" width="644.0" height="90.0" as="geometry"/></mxCell><mxCell id="v18" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;PVC data-postgres-0&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;1Gi · RWO · StorageClass standard (local-path)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;node diski: /var/local-path-provisioner/…&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#a3a3a3;strokeWidth=1.2;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="123.0" width="644.0" height="56.0" as="geometry"/></mxCell><mxCell id="v20" value="Deployment ×1" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v19"><mxGeometry x="557.8" y=