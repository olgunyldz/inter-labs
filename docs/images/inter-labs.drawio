le=none;endArrow=block;endFill=1;strokeColor=#2f7bd8;strokeWidth=3;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="v54" source="v55" target="v56"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="130.0" as="sourcePoint"/><mxPoint x="380.0" y="170.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;strokeColor=#b3b3ad;strokeWidth=1.6;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="v54" source="v56"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="278.0" as="sourcePoint"/><mxPoint x="380.0" y="320.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;strokeColor=#b3b3ad;strokeWidth=1.6;exitX=0.867;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="v10"><mxGeometry relative="1" as="geometry"><mxPoint x="2100.0" y="256.0" as="sourcePoint"/><mxPoint x="2170.0" y="980.0" as="targetPoint"/><Array as="points"><mxPoint x="2100.0" y="290.0"/><mxPoint x="2170.0" y="290.0"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#2f7bd8;strokeWidth=3;exitX=0.167;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="v8"><mxGeometry relative="1" as="geometry"><mxPoint x="160.0" y="256.0" as="sourcePoint"/><mxPoint x="720.0" y="276.0" as="targetPoint"/><Array as="points"><mxPoint x="160.0" y="276.0"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#2f7bd8;strokeWidth=3;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="v8"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="256.0" as="sourcePoint"/><mxPoint x="440.0" y="276.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e14" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#2f7bd8;strokeWidth=3;exitX=0.833;exitY=1.000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="v8"><mxGeometry relative="1" as="geometry"><mxPoint x="720.0" y="256.0" as="sourcePoint"/><mxPoint x="720.0" y="276.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e15" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#2f7bd8;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="256.0" as="sourcePoint"/><mxPoint x="1440.0" y="256.0" as="targetPoint"/><Array as="points"><mxPoint x="1220.0" y="272.0"/><mxPoint x="1440.0" y="272.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p02" name="prod · 02 · DMZ cluster'ı"><mxGraphModel dx="2200" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v9" value="DMZ CLUSTER'LARI · dmz-a + dmz-b (DC1, active-active) · dmz-dr (DC2) · iş mantığı ve veri yok" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#ffe8d4;fillOpacity=0;strokeColor=#ec9656;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#ec9656;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="14.0" y="148.0" width="2172.0" height="532.0" as="geometry"/></mxCell><mxCell id="v72" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;DMZ'de iş mantığı ve veri yok: yalnızca giriş, kimlik doğrulama, hız sınırı ve tek çıkış.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;dmz-a ve dmz-b aynı manifest; dmz-dr DC2'de aynı yapı, daha az replika.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Çıkış: uygulama ingress'ine mTLS + iç JWT; dış token DMZ'de kalır.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;auth-proxy / token-handler önerisi; mevcut API gateway'iniz varsa onun yerini tutar.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="710.0" width="1060.0" height="108.0" as="geometry"/></mxCell><mxCell id="v73" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="710.0" width="1060.0" height="212.0" as="geometry"/></mxCell><mxCell id="v105" value="02 · DMZ cluster'ı: kanal başına ingress-nginx, auth-proxy, rate limit, tek çıkış" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1221.0" height="33.8" as="geometry"/></mxCell><mxCell id="v106" value="her kutu bir namespace · satırlar pod'lar (ad · iş yükü · görev) · replika sayıları önerilir · teyitli: Kubernetes, ingress-nginx, .NET, monolith, Kafka, RabbitMQ, Couchbase, MSSQL, Oracle · diğer ürün adları öneri" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1889.2" height="21.6" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f7f9fc;strokeColor=#d8d8d3;strokeW