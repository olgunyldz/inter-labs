ight="186.0" as="geometry"/></mxCell><mxCell id="v245" value="08" style="rounded=1;arcSize=50;html=1;fillColor=#1f1f1f;strokeColor=none;fontColor=#ffffff;fontSize=12.5;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v247"><mxGeometry x="1386.0" y="2004.0" width="32.4" height="21.0" as="geometry"/></mxCell><mxCell id="v246" value="&lt;span style=&quot;font-size:19px;color:#7a3b10;&quot;&gt;Dış çıkış zone · DC1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;outbound NGFW (farklı üretici) · forward proxy: hedef / FQDN izin listesi · TLS denetimi (isteğe bağlı) · erişim logu → SIEM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;kaynaklar: her cluster'ın egress gateway'i + legacy VM'ler · hiçbir pod / VM doğrudan internete çıkmaz · kart şemaları hariç (PCI özel hattı)&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#ffefe3;strokeColor=#e39b62;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=center;spacingLeft=24;spacingTop=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" parent="v247"><mxGeometry x="26.0" y="2230.0" width="1420.0" height="124.0" as="geometry"/></mxCell><mxCell id="v249" value="&lt;span style=&quot;font-size:19px;color:#7a5200;&quot;&gt;Edge · DR + kart zone'u (DR)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;F5 LB + WAF (standby)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;GSLB felakette buraya yönlendirir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15.5px;color:#5f5f5a;&quot;&gt;kart segmenti DR kopyası (şema hatları)&lt;/span&gt;" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#fff3d9;strokeColor=#e2b04a;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=24;spacingTop=12;spacingRight=12;font