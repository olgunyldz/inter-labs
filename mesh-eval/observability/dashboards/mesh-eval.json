 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "k6 istek hızı (RPS)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mesh, test) (rate(k6_http_reqs_total[15s]))",
     "legendFormat": "{{mesh}} {{test}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "k6 p99 gecikme",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (mesh, test) (k6_http_req_duration_p99)",
     "legendFormat": "{{mesh}} {{test}}"
    }
   ]
  },
  {
   "id": 3,
