geometry"/></mxCell><mxCell id="v71" value="Couchbase SDK tüm node'lara bağlanır → ingress uygun değil:" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v9"><mxGeometry x="758.0" y="554.0" width="430.8" height="16.2" as="geometry"/></mxCell><mxCell id="v72" value="pod başına LoadBalancer + DNS (ya da istemci ağına yönlendirilmiş pod ağı)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v9"><mxGeometry x="758.0" y="574.0" width="501.0" height="16.2" as="geometry"/></mxCell><mxCell id="v74" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;Oracle RAC (2+ node) · ASM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;kim: core banking · legacy monolith&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;erişim: monolith (ODP.NET) · core-adapter · Debezium&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;port :1521 / TCPS :2484 · servis adı başına&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;Data Guard → DR standby (Max Availability / async)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;TDE · Unified Audit → SIEM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;yedek: RMAN · DR'da test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;yeni servisler doğrudan bağlanmaz&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#a383e0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v73"><mxGeometry x="20.0" y="38.0" width="666.0" height="162.0" as="geometry"/></mxCell><mxCell id="v75" value='&lt;span style="font-size:14px;color:#1f1f1f;font-weight:bold;"&gt;MSSQL Always On AG&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;kim: yeni .NET mikroservisler (servis başına DB)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;primary + senkron secondary (DC1, otomatik failover)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;asenkron secondary (DR) · listener :1433&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;MultiSubnetFailover=True · Encrypt=True&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;login: Vault dinamik (öneri) · least privilege&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;CDC açık (outbox / okuma modelleri)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;TDE · Audit → SIEM&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#a383e0;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v73"><mxGeometry x="20.0" y="222.0" width="666.0" height="162.0" as="geometry"/></mxCell><mxCell id="v76" value="kim" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v73"><mxGeometry x="28.0" y="418.5" width="26.7" height="15.5" as="geometry"/></mxCell><mxCell id="v77" value="nereye" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v73"><mxGeometry x="267.8" y="418.5" width="47.4" height="15.5" as="geometry"/></mxCell><mxCell id="v78" value="account · customer · transfer" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v73"><mxGeometry x="28.0" y="44