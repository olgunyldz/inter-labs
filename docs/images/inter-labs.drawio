 izin listesi&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;TLS / IPsec tünel&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dc6262;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="20.0" y="40.0" width="720.0" height="90.0" as="geometry"/></mxCell><mxCell id="v56" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;ATM / POS switch (kart yetkilendirme)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;ISO 8583 mesaj işleme · limit / bakiye sorgusu&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;kart şemaları: Visa · MC · TROY · BKM (özel hat)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;uygulama zone'una yalnızca card-api üzerinden (mTLS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;ayrı cluster ya da ayrı VM segmenti&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dc6262;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="20.0" y="170.0" width="720.0" height="108.0" as="geometry"/></mxCell><mxCell id="v57" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;HSM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;PIN doğrulama · anahtar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;yönetimi · ağ HSM'i (HA)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;PCI PIN&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dc6262;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="20.0" y="320.0" width="350.0" height="90.0" as="geometry"/></mxCell><mxCell id="v58" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;Tokenization&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;PAN → token&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;uygulama zone'u PAN görmez&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;kasaya yalnızca PCI erişir&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#dc6262;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="390.0" y="320.0" width="350.0" height="90.0" as="geometry"/></mxCell><mxCell id="v59" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Neden ayrı?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;PCI kapsamını daraltmak: kart verisi yalnızca bu zone'da.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;ATM / POS internetten gelmez; edge'den geçmez.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;DR'da aynı yapı (DC2 kart zone'u).&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="20.0" y="460.0" width="720.0" height="89.5" as="geometry"/></mxCell><mxCell id="v61" value="özel hat" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v54"><mxGeometry x="292.0" y="17.5" width="66.0" height="16.9" as="geometry"/></mxCell><mxCell id="v66" value="" style="html=1;rounded=1;fillColor=#fdecec;strokeColor=#e3a1a1;strokeWid