# inter-labs: prod benzeri multi-cluster demo ortamı ayarları

INGRESS_NGINX_CHART_VERSION=4.15.1
HAPROXY_IMAGE=haproxy:3.0-alpine

# Zone network'leri (docker bridge). Docker farklı bridge'ler arası trafiği
# engellediği için bunlar firewall'lı network segmentleri gibi davranır.
#   edge-lb     : lab-edge + lab-dmz          (edge LB -> DMZ ingress)
#   dmz-a / b   : lab-dmz  + lab-app          (DMZ -> A/B ingress)
#   cluster-a/b : lab-app  + lab-data         (A/B -> data ingress)
#   data        : lab-data
#   mgmt        : lab-mgmt + dmz/app/data     (mgmt -> tüm API server'lar)
NET_EDGE=lab-edge
NET_DMZ=lab-dmz
NET_APP=lab-app
NET_DATA=lab-data
NET_MGMT=lab-mgmt
NET_EDGE_SUBNET=172.28.5.0/24
NET_DMZ_SUBNET=172.28.10.0/24
NET_APP_SUBNET=172.28.20.0/24
NET_DATA_SUBNET=172.28.30.0/24
NET_MGMT_SUBNET=172.28.40.0/24

EDGE_LB=edge-lb
