t="129.0" as="geometry"/></mxCell><mxCell id="v18" value="⇥ in ← Kafka :9093 (mTLS / SASL) · out → Kafka · RabbitMQ" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="1104.0" y="346.0" width="409.3" height="19.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;İstek yolu (numaralar)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;1 ingress → transfer-api :8080 · iç JWT doğrulanır  ·  2 MSSQL'de tek transaction: transfer kaydı + outbox satırı  ·  3 RabbitMQ'ya core.posting komutu (core-adapter tüketir)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;4 outbox-relay outbox'ı okur → Kafka banka.transfer.created.v1  ·  5 notification-worker olayı tüketir → SMS / push  ·  6 202 Accepted + işlem no (sonuç olayla gelir)&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="20.0" y="413.0" width="2088.0" height="71.0" as="geometry"/></mxCell><mxCell id="v20" value="1" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="-1.0" y="77.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v21" value="2" style="ellipse;html=1;fillColor=#2f7bd8;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="-1.0" y="147.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v22" value="3" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="-1.0" y="167.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v23" value="4" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="1083.0" y="77.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v24" value="5" style="ellipse;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v3"><mxGeometry x="1083.0" y="227.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v6" value="Deployment ×3 · HPA 3-12 · PDB minAvailable 2 · SA transfer-api" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="647.5" y="7.5" width="404.5" height="15.5" as="geometry"/></mxCell><mxCell id="v7" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;app · .NET 8 · ASP.NET Core (Kestrel :8080)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;non-root · read-only root FS · capabilities drop ALL · seccomp RuntimeDefault&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;probe: /health/live · /health/ready (DB, Kafka bağımlılık kontrolü) · startup probe&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;EF Core → MSSQL AG listener (MultiSubnetFailover=True, Encrypt=True) · tek transaction: transfer + outbox&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;RabbitMQ: MassTransit (öneri) · publisher confirm · quorum queue · core.posting komutu&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;Couchbase SDK: idempotency anahtarı (X-Idempotency-Key, 24 sa) · oturum okumaz&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;Polly: timeout · retry (yalnızca okuma) · circuit breaker · bulkhead&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;iç JWT doğrulama (JwtBearer, IdP JWKS) · yetki: policy + scope&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;OpenTelemetry: iz + metrik → otel-collector · Serilog JSON → stdout&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="8.0" y="28.0" width="1044.0" height="158.0" as="geometry"/></mxCell><mxCell id="v8" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;secret'lar (volume)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;ExternalSecret → Vault: MSSQL login (dinamik), RabbitMQ kullanıcı, Couchbase RBAC kullanıcı&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;mTLS sertifikası: cert-manager (iç CA) · otomatik yenileme&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f3ecfb;strokeColor=#a383e0;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="8.0" y="191.0" width="1044.0" height="56.0" as="geometry"/></mxCell><mxCell id="v9" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;config&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;ConfigMap: appsettings.Production.json · ortam: DC1 / DR&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;migration: ayrı Job (deploy öncesi) · pod içinde migration yok&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#a3a3a3;strokeWidth=1.2;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="8.0" y="252.0" width="1044.0" height="56.0" as="geometry"/></mxCell><mxCell id="v13" value="Deployment ×2 · tek aktif (lease)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v12"><mxGeometry x="781.3" y="7.5" width="214.7" height="15.5" as="geometry"/></mxCell><mxCell id="v14" value='&lt;span style="font-size:12.5px;color:#1f1f1f;font-weight:bold;"&gt;app · .NET 8 worker (BackgroundService)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;outbox tablosunu okur (ya da Debezium CDC)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;Confluent.Kafka producer: acks=all · idempotent&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;konu: banka.transfer.created.v1 · anahtar: hesap no&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;Schema Registry (Avro / JSON Schema)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11.5px;color:#3a3a3a;"&gt;gönderilen satır işaretlenir · en az bir kez&lt;/span&gt;' style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v12"><mxGeometry x="8.0" y="28.0" width="988.0" height="107.0" as="geometry"/></mxCell><mxCell id="v16" value="Deployment · KEDA 1-20 (Kafka lag)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="775.0" y="7.5" width="221.1" height="15.5" as="geometry"/></mxCell><mxCell id="v17" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;app · .NET 8 worker&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;consumer group: notification · manuel commit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;işlenen olay id'si Couchbase'te (tekrar koruması)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;→ RabbitMQ sms.send kuyruğu → SMS sağlayıcı (egress)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;zehirli mesaj → DLQ konusu&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#eaf2fd;strokeColor=#6d9fe4;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="28.0" width="988.0" height="90.0" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=block;endFill=1;strokeColor=#2f7bd8;strokeWidth=3;entryX=0.325;entryY=0.000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="v2" target="v5"><mxGeometry relative="1" as="geometry"><mxPoint x="386.0" y="16.0" as="sourcePoint"/><mxPoint x="386.0" y="76.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;strokeColor=#b3b3ad;strokeWidth=1.6;dashed=1;dashPattern=6 5;exitX=1.008;exitY=0.304;exitDx=0;exitDy=0;exitPerimeter=0;entryX=-0.008;entryY=0.449;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="v3" source="v7" target="v14"><mxGeometry relative="1" as="geometry"><mxPoint x="1080.0" y="120.0" as="sourcePoint"/><mxPoint x="1104.0" y="120.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#6d9fe4;strokeWidth=3;dashed=1;dashPattern=3 2;" edge="1" parent="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="42.0" as="sourcePoint"/><mxPoint x="1100.0" y="42.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#2f7bd8;strokeWidth=3;" edge="1" parent="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="14.0" y="98.0" as="sourcePoint"/><mxPoint x="44.0" y="98.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#b3b3ad;strokeWidth=1.8;" edge="1" parent="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="366.0" y="98.0" as="sourcePoint"/><mxPoint x="396.0" y="98.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#b3b3ad;strokeWidth=1.8;dashed=1;" edge="1" parent="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="718.0" y="98.0" as="sourcePoint"/><mxPoint x="748.0" y="98.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=none;strokeColor=#b91c1c;strokeWidth=2;dashed=1;" edge="1" parent="v25"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="98.0" as="sourcePoint"/><mxPoint x="1100.0" y="98.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p05" name="prod · 05 · Legacy monolith ve strangler geçişi"><mxGraphModel dx="2200" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1170" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v10" value="LEGACY ZONE · Windows VM'ler · DC1 (DR'da kopyası)" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#e7e9fb;fillOpacity=25;strokeColor=#8790e6;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#8790e6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="14.0" y="148.0" width="1086.0" height="712.0" as="geometry"/></mxCell><mxCell id="v38" value="UYGULAMA CLUSTER'I · strangler cephesi" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#e4eefc;fillOpacity=15;strokeColor=#6d9fe4;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#6d9fe4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="148.0" width="1066.0" height="712.0" as="geometry"/></mxCell><mxCell id="v64" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Monolith .NET Framework / IIS üzerinde VM'lerde; taşınan modüller cluster'da.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Giriş tek: uygulama ingress'i. Yol bazlı kural yeni servise ya da monolith'e yönlendirir.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Veri iki yönde senkron: Oracle CDC → yeni servisler; yeni servis olayları → ACL → monolith.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Yeni servisler Oracle'a doğrudan bağlanmaz; core-adapter ve CDC tek geçit.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="890.0" width="1060.0" height="108.0" as="geometry"/></mxCell><mxCell id="v65" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="890.0" width="1060.0" height="72.0" as="geometry"/></mxCell><mxCell id="v72" value="05 · Legacy monolith ve strangler geçişi: VM'ler, yönlendirme, CDC, ACL" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1071.0" height="33.8" as="geometry"/></mxCell><mxCell id="v73" value="monolith VM'de (.NET Framework / IIS) · taşınan modüller cluster'da · teyitli: Kubernetes, ingress-nginx, .NET, monolith, Kafka, RabbitMQ, Couchbase, MSSQL, Oracle · diğer ürün adları öneri" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1669.2" height="21.6" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v38"><mxGeometry x="20.0" y="612.0" width="1026.0" height="24.0" as="geometry"/></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f7f9fc;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v38"><mxGeometry x="20.0" y="586.0" width="1026.0" height="24.0" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v38"><mxGeometry x="20.0" y="560.0" width="1026.0" height="24.0" as="geometry"/></mxCell><mxCell id="v5" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f1f3f6;strokeColor=#c4c4bf;strokeWidth=0.8;fontFamily=Segoe UI;" vertex="1" parent="v38"><mxGeometry x="20.0" y="532.0" width="1026.0" height="26.0" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="26.0" y="684.0" width="1036.0" he