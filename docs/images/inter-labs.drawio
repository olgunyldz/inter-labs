ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v8"><mxGeometry x="580.0" y="22.0" width="240.0" height="78.0" as="geometry"/></mxCell><mxCell id="v14" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;Şube kullanıcıları&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;gişe · operasyon · SD-WAN&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v9"><mxGeometry x="20.0" y="22.0" width="200.0" height="78.0" as="geometry"/></mxCell><mxCell id="v15" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;ATM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;ATM ağı · ISO 8583&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v9"><mxGeometry x="240.0" y="22.0" width="200.0" height="78.0" as="geometry"/></mxCell><mxCell id="v16" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;POS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;üye işyeri · acquirer&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v9"><mxGeometry x="460.0" y="22.0" width="200.0" height="78.0" as="geometry"/></mxCell><mxCell id="v17" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;Operasyon · yazılım ekipleri&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;VPN → PAM / bastion → mgmt · CI/CD&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v10"><mxGeometry x="20.0" y="22.0" width="560.0" height="78.0" as="geometry"/></mxCell><mxCell id="v21" value='&lt;span style="font-size:14px;color:#1f1f1f;font-weight:bold;"&gt;F5 LTM çifti (HA)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;aktif / standby · bağlantı senkronu&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;kanal başına VIP + sertifika&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;TLS 1.2+/1.3 · HSTS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;X-Forwarded-For / PROXY ekler&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;→ DMZ ingress (TLS yeniden şifreli)&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2b04a;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v20"><mxGeometry x="20.0" y="30.0" width="420.0" height="126.0" as="geometry"/></mxCell><mxCell id="v22" value='&lt;span style="font-size:14px;color:#1f1f1f;font-weight:bold;"&gt;WAF (F5 ASM / AWAF ya da ayrı)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;OWASP CRS · pozitif güvenlik&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;API şema (OpenAPI) doğrulama&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;bot · credential stuffing koruması&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;IP itibar · coğrafi kural&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;blok logu → SIEM&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2b04a;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v20"><mxGeometry x="460.0" y="30.0" width="420.0" height="126.0" as="geometry"/></mxCell><mxCell id=