ashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#e3a1a1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20.0" y="140.0" width="840.0" height="116.0" as="geometry"/></mxCell><mxCell id="v5" value="KURUM WAN · ÖZEL HAT" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#eef2f7;fillOpacity=70;strokeColor=#94a3b8;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#94a3b8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880.0" y="140.0" width="520.0" height="116.0" as="geometry"/></mxCell><mxCell id="v6" value="KURUM AĞI · VPN" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#eef2f7;fillOpacity=70;strokeColor=#94a3b8;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#94a3b8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1420.0" y="140.0" width="760.0" height="116.0" as="geometry"/></mxCell><mxCell id="v13" value="DOCKER AĞI lab-edge · 172.28.5.0/24 · internet tarafı" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#fff3d9;fillOpacity=25;strokeColor=#e2b04a;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#e2b04a;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20.0" y="330.0" width="1060.0" height="530.0" as="geometry"/></mxCell><mxCell id="v24" value="DOCKER AĞI lab-dmz · 172.28.10.0/24" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#ffe8d4;fillOpacity=20;strokeColor=#ec9656;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#ec9656;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1110.0" y="330.0" width="1070.0" height="530.0" as="geometry"/></mxCell><mxCell id="v38" value="Edge zone'da olması gereken (lab'da yok)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13.5;fontColor=#b91c1c;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="880.5" width="330.0" height="18.2" as="geometry"/></mxCell><mxCell id="v39" value="· DDoS koruması / scrubbing · CDN (sağlayıcı katmanı)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="903.5" width="370.4" height="16.9" as="geometry"/></mxCell><mxCell id="v40" value="· GSLB: DC1 / DC2 aktif-aktif, sağlık bazlı yönlendirme" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="923.0" width="384.1" height="16.9" as="geometry"/></mxCell><mxCell id="v41" value="· F5 LB çifti (HA) · kanal başına VIP: mobil, web, partner" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="942.5" width="404.8" height="16.9" as="geometry"/></mxCell><mxCell id="v42" value="· WAF: OWASP CRS, bot yönetimi, API şema doğrulama" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="962.0" width="349.8" height="16.9" as="geometry"/></mxCell><mxCell id="v43" value="· TLS 1.2+/1.3, HSTS, sertifika yaşam döngüsü · partner mTLS" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1142.0" y="981.5" width="418.5" height="16.9" as="geometry"/></mxCell><mxCell id="v44" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Kubernetes dışındaki tek bileşen edge-lb: bir Docker container'ı.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Beş kanal da lab'da aynı girişi kullanır (127.0.0.1:443); hedefte ATM / POS özel hattan PCI zone'una gider.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;TLS DMZ'de açılır; edge-lb yalnızca TCP dağıtır ve istemci IP'sini PROXY protocol ile taşır.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Failover: dmz-a durdurulunca ~10 sn'de DOWN, trafik dmz-b'ye geçti (verify ile denendi).&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="880.0" width="1040.0" height="108.0" as="geometry"/></mxCell><mxCell id="v45" value="TCP :443" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="452.0" y="283.5" width="66.0" height="16.9" as="geometry"/></mxCell><mxCell id="v47" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="1040.0" width="1040.0" height="100.0" as="geometry"/></mxCell><mxCell id="v58" value="hedef mimaride olması gereken · lab'da yok" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1170.0" y="1038.0" width="306.3" height="17.6" as="geometry"/></mxCell><mxCell id="v59" value="01 · Edge zone: kanallar, edge-lb (HAProxy) içi, Docker ağları" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="936.0" height="33.8" as="geometry"/></mxCell><mxCell id="v60" value="frontend / backend · sağlık kontrolü · PROXY protocol · hangi ağa bağlı, hangisine değil · kırmızı kesikli = hedefte olması gereken" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1158.8" height="21.6" as="geometry"/></mxCell><mxCell id="v7" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;Mobil Bankacılık&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;iOS · Android&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v4"><mxGeometry x="20.0" y="22.0" width="240.0" height="78.0" as="geometry"/></mxCell><mxCell id="v8" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;İnternet Şubesi&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;web · tarayıcı&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v4"><mxGeometry x="300.0" y="22.0" width="240.0" height="78.0" as="geometry"/></mxCell><mxCell id="v9" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;Partner API&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;açık bankacılık · 3. taraf&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v4"><mxGeometry x="580.0" y="22.0" width="240.0" height="78.0" as="geometry"/></mxCell><mxCell id="v10" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;ATM&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;ATM ağı · ISO 8583&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="20.0" y="22.0" width="220.0" height="78.0" as="geometry"/></mxCell><mxCell id="v11" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;POS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;üye işyeri · acquirer&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v5"><mxGeometry x="280.0" y="22.0" width="220.0" height="78.0" as="geometry"/></mxCell><mxCell id="v12" value='&lt;span style="font-size:19px;color:#1f1f1f;font-weight:600;"&gt;Operasyon ekibi&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:14.5px;color:#5f5f5a;"&gt;VPN · kubectl · 127.0.0.1:9080 / 9443&lt;/span&gt;' style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#c4c4bf;strokeWidth=1.6;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="20.0" y="22.0" width="720.0" height="78.0" as="geometry"/></mxCell><mxCell id="v14" value="⇥ in ← host 127.0.0.1:80 · :443 (müşteri) · :9404 (istatistik)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="596.2" y="13.0" width="443.8" height="19.0" as="geometry"/></mxCell><mxCell id="v15" value="◼ edge-lb" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#e2b04a;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="20.0" y="40.0" width="1020.0" height="346.0" as="geometry"/></mxCell><mxCell id="v21" value="↦ out → dmz-a / dmz-b :80 · :443 (TCP + PROXY v1)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="685.9" y="395.0" width="354.1" height="19.0" as="geometry"/></mxCell><mxCell id="v22" value="Ağ bacakları" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="20.0" y="432.0" width="106.8" height="18.9" as="geometry"/></mxCell><mxCell id="v23" value="eth: lab-edge 172.28.5.2 (birincil · host port'ları buradan)  ·  lab-dmz 172.28.10.5 (DMZ'ye tek bacak)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="20.0" y="457.5" width="714.1" height="16.9" as="geometry"/></mxCell><mxCell id="v25" value="▣ dmz-a-control-plane" style="swimlane;html=1;startSize=26;rounded=1;arcSize=2;container=1;collapsible=0;fillColor=#55554f;swimlaneFillColor=#fbfbfa;strokeColor=#55554f;strokeWidth=2;swimlaneLine=0;align=left;spacingLeft=10;fontSize=13.5;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="v24"><mxGeometry x="20.0" y="40.0" width="1030.0" height="128.0" as="geometry"/></mxCell><mxCell id="v30" value="▣ dmz-b-control-plane" style="swimlane;html=1;startSize=26;rounded=1;arcSize=2;container=1;collapsible=0;fillColor=#55554f;swimlaneFillColor=#fbfbfa;strokeColor=#55554f;strokeWidth=2;swimlaneLine=0;align=left;spacingLeft=10;fontSize=13.5;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="v24"><mxGeometry x="20.0" y="190.0" width="1030.0" height="128.0" as="geometry"/></mxCell><mxCell id="v35" value="▣ mgmt-control-plane (bacak)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=2;container=1;collapsible=0;fillColor=#55554f;swimlaneFillColor=#fbfbfa;strokeColor=#55554f;strokeWidth=2;swimlaneLine=0;align=left;spacingLeft=10;fontSize=13.5;fontStyle=1;fontColor=#ffffff;fontFamily=Segoe UI;" vertex="1" parent="v24"><mxGeometry x="20.0" y="340.0" width="1030.0" height="80.0" as="geometry"/></mxCell><mxCell id="v46" value="edge-lb → lab-app / lab-data: bağlı değil, yol yok (verify: cluster-a :80 engelli)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#b91c1c;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v13"><mxGeometry x="292.0" y="489.5" width="621.0" height="16.9" as="geometry"/></mxCell><mxCell id="v48" value="" style="html=1;rounded=1;fillColor=#fdecec;strokeColor=#e3a1a1;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="14.0" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v49" value="internet" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="54.0" y="34.0" width="63.2" height="17.6" as="geometry"/></mxCell><mxCell id="v50" value="" style="html=1;rounded=1;fillColor=#eef2f7;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="351.3" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v51" value="kurum WAN / VPN" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="391.3" y="34.0" width="113.3" height="17.6" as="geometry"/></mxCell><mxCell id="v52" value="" style="html=1;rounded=1;fillColor=#fff3d9;strokeColor=#e2b04a;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="688.7" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v53" value="edge" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="728.7" y="34.0" width="34.6" height="17.6" as="geometry"/></mxCell><mxCell id="v54" value="" style="html=1;rounded=1;fillColor=#ffe8d4;strokeColor=#ec9656;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="14.0" y="62.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v55" value="DMZ" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="54.0" y="62.0" width="27.5" height="17.6" as="geometry"/></mxCell><mxCell id="v56" value="" style="html=1;rounded=1;fillColor=#e5f4e5;strokeColor=#6abd6a;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="351.3" y="62.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v57" value="yönetim" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v47"><mxGeometry x="391.3" y="62.0" width="56.1" height="17.6" as="geometry"/></mxCell><mxCell id="v16" value="Docker container · haproxy:3.0-alpine · restart unless-stopped" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="613.8" y="7.5" width="398.2" height="15.5" as="geometry"/></mxCell><mxCell id="v17" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;frontend http :80 · frontend https :443&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;mode tcp · TLS'e dokunmaz (sonlandırma DMZ'de)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;timeout connect 3 sn · client / server 60 sn&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;log stdout (tcplog) → docker logs edge-lb&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="28.0" width="1004.0" height="73.0" as="geometry"/></mxCell><mxCell id="v18" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;backend dmz_http · backend dmz_https&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;balance roundrobin&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;server dmz-a 172.28.10.2:80 / :443 · server dmz-b 172.28.10.4:80 / :443&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;send-proxy (PROXY v1: istemci IP'si ve portu DMZ'ye taşınır)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;sağlık: option httpchk GET /healthz · expect 200 · check port 80&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;inter 3 sn · fall 2 · rise 2 → ~6-10 sn'de DOWN · check-send-proxy&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=#e39b62;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="106.0" width="1004.0" height="107.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;frontend stats :8404&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;mode http · stats uri / · 5 sn'de yenilenir&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;host 127.0.0.1:9404 · CSV: /;csv (verify.sh okur)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#e8f5e8;strokeColor=#6abd6a;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="218.0" width="1004.0" height="56.0" as="geometry"/></mxCell><mxCell id="v20" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;yapılandırma&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;edge/haproxy.cfg.tpl → up.sh IP'leri doldurur → .edge/haproxy.cfg (salt okunur mount)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;--sysctl net.ipv4.ip_unprivileged_port_start=0 (non-root :80 / :443)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#a3a3a3;strokeWidth=1.2;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacing=2;fontFamily=Segoe UI;" vertex="1" parent="v15"><mxGeometry x="8.0" y="279.0" width="1004.0" height="56.0" as="geometry"/></mxCell><mxCell id="v26" value="kindest/node v1.37.0" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#e4e4de;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v25"><mxGeometry x="882.0" y="6.0" width="138.0" height="16.2" 