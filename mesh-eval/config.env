# mesh-eval: service mesh değerlendirmesi ayarları
# Tüm sürümler sabittir; değiştirilirse rapora otomatik yansır (meta.json -> versions).

# --- Mesh sürümleri ---------------------------------------------------------
ISTIO_VERSION=1.31.4
ISTIO_PREV_VERSION=1.30.8          # R05 (kesintisiz güncelleme) testinde başlangıç sürümü
ISTIO_HUB=docker.io/istio
LINKERD_VERSION=edge-26.11.2
LINKERD_PREV_VERSION=edge-26.10.2  # R05 başlangıç sürümü
GATEWAY_API_VERSION=v1.6.1         # Istio 1.31 (v1.6.0 ile derlenmiş) ve Linkerd edge-26.11 (v1.6.1 ister) ortak

# --- Gözlem (mgmt cluster'ı) ------------------------------------------------
PROMETHEUS_CHART_VERSION=29.47.2
KSM_CHART_VERSION=9.0.1
GRAFANA_CHART_VERSION=10.5.15
TEMPO_CHART_VERSION=1.24.4

# --- Test bileşenleri -------------------------------------------------------
K6_IMAGE=grafana/k6:2.4.0
FAKE_SERVICE_IMAGE=nicholasjackson/fake-service:v0.26.2
NETSHOOT_IMAGE=nicolaka/netshoot:v0.14

# --- Ortam ------------------------------------------------------------------
BENCH_CLUSTER=cluster-a            # mesh'in kurulduğu cluster
SHOP_NS=shop                       # test servis zinciri
LOADGEN_NS=loadgen                 # k6
OUTSIDE_NS=outside                 # mesh dışı (atlatma denemeleri)

# Node CPU sabitleme (docker cpuset). Host: 12 çekirdek.
#   app node'u ve loadgen node'u ayrı çekirdeklerde -> ölçüm tekrarlanabilir
CPUSET_APP=0-3
CPUSET_LOADGEN=4-6
CPUSET_CONTROL=7-8
CPUSET_OTHER=9-11                  # diğer tüm kind node'ları + edge LB

# --- Servis zinciri (fake-service) -----------------------------------------
# Her servisin kendi işlem süresi (yapay). Mesh ek maliyetinin görünmesi için kısa tutulur.
SVC_TIMING_P50=1ms
SVC_TIMING_P90=2ms
SVC_TIMING_P99=5ms
SVC_REPLICAS=2

# --- Prod projeksiyonu varsayımları (rapor) ---------------------------------
PROD_SERVICES=3000
PROD_REPLICAS_PER_SERVICE=3        # varsayım: ortalama replika
PROD_PODS_PER_NODE=30              # varsayım: node başına ortalama pod
PROD_NODE_VCPU=16                  # varsayım: worker node boyutu
PROD_NODE_MEM_GB=64
PROD_TOTAL_RPS=30000               # varsayım: tüm servislerin toplam iç (east-west) istek hızı

# Uygulama (fake-service) seviyesinde Zipkin trace'i. Varsayılan kapalı: yük testlerinde her isteğin
# span'ı ölçümü bozar. O01 testi geçici olarak açar.
SVC_TRACING_ZIPKIN=
PROD_SERVICES_PER_WAYPOINT=10        # varsayım: ambient L7 için waypoint başına servis (namespace başına bir waypoint)
