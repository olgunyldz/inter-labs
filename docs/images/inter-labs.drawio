mxGraphModel></diagram><diagram id="p01" name="prod · 01 · Giriş"><mxGraphModel dx="2200" dy="1170" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1170" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v8" value="İNTERNET · GÜVENİLMEYEN AĞ" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#fdecec;fillOpacity=55;strokeColor=#e3a1a1;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#e3a1a1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20.0" y="140.0" width="840.0" height="116.0" as="geometry"/></mxCell><mxCell id="v9" value="KURUM WAN · ŞUBE AĞI · ÖZEL HAT" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#eef2f7;fillOpacity=70;strokeColor=#94a3b8;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#94a3b8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880.0" y="140.0" width="680.0" height="116.0" as="geometry"/></mxCell><mxCell id="v10" value="KURUM AĞI · VPN" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#eef2f7;fillOpacity=70;strokeColor=#94a3b8;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#94a3b8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1580.0" y="140.0" width="600.0" height="116.0" as="geometry"/></mxCell><mxCell id="v18" value='&lt;span style="font-size:19px;color:#333333;"&gt;Sağlayıcı katmanı (banka dışı)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:15.5px;color:#5f5f5a;"&gt;DDoS scrubbing · CDN (statik içerik) · bot yönetimi&lt;/span&gt;' style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;dropTarget=0;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#a3a3a3;strokeWidth=1.8;dashed=1;dashPattern=4 3;verticalAlign=top;align=center;spacingLeft=24;spacingTop=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="300.0" width="1340.0" height="100.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;GSLB (DNS) · api.banka · www.banka · ib.banka · openapi.banka&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;sağlık kontrolüne göre DC1 VIP'leri · DC1 düşerse DR VIP'leri (TTL kısa: 30-60 sn)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;aktif-pasif: DC2 yalnızca felakette · iki DC arasında oturum taşınmaz (Couchbase XDCR ile oturum DR'da da var)&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e2b04a;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="430.0" width="1340.0" height="72.0" as="geometry"/></mxCell><mxCell id="v20" value="DC1 · EDGE ZONE" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#fff3d9;fillOpacity=25;strokeColor=#e2b04a;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#e2b04a;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20.0" y="540.0" width="1380.0" height="400.0" as="geometry"/></mxCell><mxCell id="v54" value="KART ZONE · PCI DSS · internete kapalı" style="rounded=0;html=1;container=1;collapsible=0;dropTarget=0;fillColor=#fde3e3;fillOpacity=35;strokeColor=#dc6262;strokeWidth=3;dashed=1;dashPattern=4 2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=-13;fontSize=13.5;fontStyle=1;fontColor=#ffffff;labelBackgroundColor=#dc6262;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1420.0" y="300.0" width="760.0" height="640.0" as="geometry"/></mxCell><mxCell id="v60" value="→ DMZ ingress'leri :443 (02)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1137.0" y="943.5" width="216.0" height="16.9" as="geometry"/></mxCell><mxCell id="v62" value="şube WAN → şube zone → uygulama ingress (00)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1044.0" y="973.5" width="336.0" height="16.9" as="geometry"/></mxCell><mxCell id="v63" value="VPN → PAM → mgmt (08)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=12.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="2007.6" y="963.5" width="150.4" height="16.9" as="geometry"/></mxCell><mxCell id="v64" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Bu resimde&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;İnternet kanalları (mobil, web, partner) GSLB → F5 + WAF → DMZ ingress yolunu izler.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;ATM ve POS ayrı: özel hat → PCI zone'u; kart verisi uygulama zone'una tokenize gelir.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Şube kullanıcıları internetten değil kurum WAN'ından: şube zone'u (branch-fw → branch-gateway) → uygulama.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Ürün adları (F5, NGFW) yaygın tercihlerdir; mevcut cihazlarınızla değiştirilebilir.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="990.0" width="1060.0" height="108.0" as="geometry"/></mxCell><mxCell id="v65" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="990.0" width="1060.0" height="100.0" as="geometry"/></mxCell><mxCell id="v76" value="01 · Giriş: kanallar, GSLB, edge (F5 + WAF), ATM / POS → kart zone'u" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1026.0" height="33.8" as="geometry"/></mxCell><mxCell id="v77" value="her kanalın girdiği yol · VIP ve DMZ ingress eşlemesi · teyitli: Kubernetes, ingress-nginx, .NET, monolith, Kafka, RabbitMQ, Couchbase, MSSQL, Oracle · diğer ürün adları öneri" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1546.0" height="21.6" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v20"><mxGeometry x="20.0" y="322.0" width="1300.0" height="24.0" as="geometry"/></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f7f9fc;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v20"><mxGeometry x="20.0" y="296.0" width="1300.0" height="24.0" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v20"><mxGeometry x="20.0" y="270.0" width="1300.0" height="24.