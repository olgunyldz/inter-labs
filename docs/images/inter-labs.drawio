şube bilgileri örnek; uçtan uca akış: 11.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="640.0" width="1060.0" height="89.5" as="geometry"/></mxCell><mxCell id="v35" value="Lejant" style="rounded=1;arcSize=3;html=1;container=1;collapsible=0;fillColor=#fafaf8;strokeColor=#c4c4bf;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1120.0" y="640.0" width="1060.0" height="72.0" as="geometry"/></mxCell><mxCell id="v40" value="15 · Şube zone'u: SD-WAN hub, branch-fw, branch-gateway (ingress-nginx), şube bazlı kurallar" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=25;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="21.0" width="1386.0" height="33.8" as="geometry"/></mxCell><mxCell id="v41" value="kurum WAN'dan gelen şube trafiği · cihaz sertifikası + personel kimliği · teyitli: Kubernetes, ingress-nginx, .NET, monolith, Kafka, RabbitMQ, Couchbase, MSSQL, Oracle · diğer ürün adları öneri" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40.0" y="62.0" width="1704.4" height="21.6" as="geometry"/></mxCell><mxCell id="v2" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="404.0" width="1060.0" height="24.0" as="geometry"/></mxCell><mxCell id="v3" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f7f9fc;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="378.0" width="1060.0" height="24.0" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#d8d8d3;strokeWidth=0.7;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="352.0" width="1060.0" height="24.0" as="geometry"/></mxCell><mxCell id="v5" value="" style="rounded=1;arcSize=8;html=1;fillColor=#f1f3f6;strokeColor=#c4c4bf;strokeWidth=0.8;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="324.0" width="1060.0" height="26.0" as="geometry"/></mxCell><mxCell id="v7" value="⇥ in ← şubeler: SD-WAN / MPLS tünelleri · yalnızca :443 (+ yazıcı / kuyruk sunucu portları)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#1d7a46;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#1d7a46;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="25.0" width="643.9" height="19.0" as="geometry"/></mxCell><mxCell id="v8" value="↦ out → uygulama ingress :443 (mTLS + iç JWT) · kimlik zone'u (AD SSO) · mgmt (log)" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#ffffff;strokeColor=#c2410c;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11.5;fontStyle=1;fontColor=#c2410c;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="1557.3" y="25.0" width="588.7" height="19.0" as="geometry"/></mxCell><mxCell id="v9" value='&lt;span style="font-size:14px;color:#1f1f1f;font-weight:bold;"&gt;SD-WAN hub ×2 (HA)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;şube başına IPsec tüneli · MPLS yedek hat&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;şube başına VLAN / VRF ayrımı&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;QoS: gişe uygulaması öncelikli&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;şube cihaz envanteri (NAC)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#2b2b2b;"&gt;yönetim: ayrı OOB ağı&lt;/span&gt;' style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="72.0" width="520.0" height="126.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;span style=&quot;font-size:14px;color:#1f1f1f;font-weight:bold;&quot;&gt;branch-fw (iç firewall, HA çift)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;kaynak: şube VLAN'ları · hedef: branch-gateway :443&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;şubeden başka hedefe yol yok (internet, DMZ, veri)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;IPS · uygulama tanıma&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;TLS'e dokunmaz (uçtan uca mTLS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#2b2b2b;&quot;&gt;log → SIEM&lt;/span&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="566.0" y="72.0" width="520.0" height="126.0" as="geometry"/></mxCell><mxCell id="v11" value="◼ branch-gateway (ingress-nginx · A/B)" style="swimlane;html=1;startSize=26;rounded=1;arcSize=6;container=1;collapsible=0;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.8;swimlaneLine=0;align=left;spacingLeft=8;fontSize=13.5;fontStyle=1;fontColor=#1f1f1f;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="1106.0" y="72.0" width="1046.0" height="190.0" as="geometry"/></mxCell><mxCell id="v15" value="Şube başına bilgiler (örnek)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="26.0" y="298.0" width="241.2" height="18.9" as="geometry"/></mxCell><mxCell id="v16" value="şube" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="34.0" y="330.5" width="33.6" height="15.5" as="geometry"/></mxCell><mxCell id="v17" value="cihaz sertifikası" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="161.2" y="330.5" width="123.3" height="15.5" as="geometry"/></mxCell><mxCell id="v18" value="VLAN / VRF" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="479.2" y="330.5" width="75.0" height="15.5" as="geometry"/></mxCell><mxCell id="v19" value="izinli kullanıcılar" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="691.2" y="330.5" width="137.1" height="15.5" as="geometry"/></mxCell><mxCell id="v20" value="0001" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="34.0" y="357.5" width="33.6" height="15.5" as="geometry"/></mxCell><mxCell id="v21" value="CN=sube-0001 · Branch CA" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="161.2" y="357.5" width="157.8" height="15.5" as="geometry"/></mxCell><mxCell id="v22" value="VLAN 101 / VRF şube" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="479.2" y="357.5" width="126.2" height="15.5" as="geometry"/></mxCell><mxCell id="v23" value="gişe · operasyon · şube müdürü (AD grupları)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="691.2" y="357.5" width="284.3" height="15.5" as="geometry"/></mxCell><mxCell id="v24" value="0002" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="34.0" y="383.5" width="33.6" height="15.5" as="geometry"/></mxCell><mxCell id="v25" value="CN=sube-0002 · Branch CA" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="161.2" y="383.5" width="157.8" height="15.5" as="geometry"/></mxCell><mxCell id="v26" value="VLAN 102 / VRF şube" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="479.2" y="383.5" width="126.2" height="15.5" as="geometry"/></mxCell><mxCell id="v27" value="gişe · operasyon" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="691.2" y="383.5" width="107.2" height="15.5" as="geometry"/></mxCell><mxCell id="v28" value="genel müdürlük" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#1f1f1f;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="34.0" y="409.5" width="102.6" height="15.5" as="geometry"/></mxCell><mxCell id="v29" value="CN=gm-ops · Branch CA" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="161.2" y="409.5" width="138.8" height="15.5" as="geometry"/></mxCell><mxCell id="v30" value="VLAN 900" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="479.2" y="409.5" width="56.6" height="15.5" as="geometry"/></mxCell><mxCell id="v31" value="merkez operasyon · denetim (salt okunur)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#2b2b2b;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="691.2" y="409.5" width="259.0" height="15.5" as="geometry"/></mxCell><mxCell id="v32" value="&lt;span style=&quot;font-size:13.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;Kurallar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Şube personeli kimliği AD'den gelir; iç JWT'de rol (gişe, müdür) ve şube kodu taşınır.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Limit üstü işlemler 4 göz: ikinci onay branch-bff'te zorunlu.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#2b2b2b;&quot;&gt;Kayıp / çalınan cihaz: sertifika iptal (CRL / OCSP) → gateway bağlantıyı keser.&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#fffdf3;strokeColor=#d8cfa3;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="v6"><mxGeometry x="1106.0" y="282.0" width="1046.0" height="89.5" as="geometry"/></mxCell><mxCell id="v36" value="" style="html=1;rounded=1;fillColor=#eef2f7;strokeColor=#94a3b8;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v35"><mxGeometry x="14.0" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v37" value="şube / kurum WAN" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v35"><mxGeometry x="54.0" y="34.0" width="120.4" height="17.6" as="geometry"/></mxCell><mxCell id="v38" value="" style="html=1;rounded=1;fillColor=#e4eefc;strokeColor=#6d9fe4;strokeWidth=1.5;fontFamily=Segoe UI;" vertex="1" parent="v35"><mxGeometry x="358.0" y="34.0" width="30.0" height="17.0" as="geometry"/></mxCell><mxCell id="v39" value="uygulama" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#1f1f1f;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v35"><mxGeometry x="398.0" y="34.0" width="63.2" height="17.6" as="geometry"/></mxCell><mxCell id="v12" value="Deployment ×2 · ayrı küçük cluster ya da VM (öneri)" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=middle;spacing=0;fontSize=11.5;fontColor=#5f5f5a;fontStyle=0;fontFamily=Segoe UI;" vertex="1" parent="v11"><mxGeometry x="709.4" y="7.5" width="328.6" height="15.5" as="geometry"/></mxCell><mxCell id="v13" value="&lt;span style=&quot;font-size:12.5px;color:#1f1f1f;font-weight:bold;&quot;&gt;ingress-nginx (nginx-branch)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;auth-tls-verify-client: on · auth-tls-secret: şube CA (cihaz sertifikası)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;sertifika CN → şube kodu (ör. 0001) · XFCC başlığı → uygulama&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;auth-url: kimlik zone'u (personel token doğrulama → iç JWT)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;limit-rps (şube başına) · yalnızca /branch/v1/* yolları&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#3a3a3a;&quot;&gt;upstream: uygulama ingress :443 (proxy-ssl, mTLS)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#fff1e0;strokeColor=